# Tercih edilen yöntem: uygulama açılınca anahtarı gizli olarak gir.
# Kalıcı saklamak istersen bu dosyayı .env adıyla kopyalayabilirsin.
# .env düz metindir; anahtarını paylaşma veya depoya ekleme.
UMAY_API_KEY=
UMAY_MODEL=umay-akilli
UMAY_BASE_URL=https://umayzeka.com/v1
# Python PATH'te değilse tam python.exe yolunu gir:
# UMAY_PYTHON=C:\Python314\python.exe
